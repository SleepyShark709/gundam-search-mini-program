<scroll-view class="page" scroll-y>
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="title">我的</view>

  <view class="refresh-banner" wx:if="{{hasUserInfo && (userLoading || userLoadError)}}">
    <view class="inline-spinner" wx:if="{{userLoading}}"></view>
    <text class="refresh-message">{{userLoading ? '正在同步资料…' : '资料同步失败，已保留上次资料'}}</text>
    <button class="inline-retry" wx:if="{{userLoadError}}" bind:tap="handleRetry">重试</button>
  </view>

  <view class="user-section" wx:if="{{userLoading && !hasUserInfo}}">
    <text class="status-title">正在同步资料…</text>
  </view>
  <view class="user-section" wx:elif="{{userLoadError && !hasUserInfo}}">
    <text class="status-title">资料暂时加载失败</text>
    <text class="status-subtitle">请检查网络后重试</text>
    <button class="retry-button" bind:tap="handleRetry">重试</button>
  </view>

  <!-- User section: logged in -->
  <view class="user-section" wx:elif="{{isLoggedIn}}">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
    </button>
    <text class="nickname">{{nickname}}</text>
  </view>

  <!-- User section: setup -->
  <view class="user-section setup" wx:else>
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image
        class="avatar"
        src="{{tempAvatarUrl}}"
        wx:if="{{tempAvatarUrl}}"
        mode="aspectFill"
      />
      <view class="avatar-placeholder" wx:else>
        <view class="avatar-placeholder-icon"></view>
      </view>
    </button>

    <text class="setup-hint">{{tempAvatarUrl ? '点击更换头像' : '点击设置头像'}}</text>

    <view class="nickname-field">
      <input
        type="nickname"
        class="nickname-input"
        placeholder="设置昵称"
        placeholder-class="nickname-placeholder"
        value="{{tempNickname}}"
        bindchange="onNicknameChange"
      />
    </view>

    <view class="save-btn-wrapper" wx:if="{{tempAvatarUrl && tempNickname}}">
      <button
        class="save-btn"
        bind:tap="saveProfile"
        disabled="{{saving}}"
        hover-class="save-btn-hover"
      >
        完成
      </button>
    </view>
  </view>

  <!-- Menu -->
  <view class="menu-section">
    <view class="menu-item" bind:tap="handleWishlist" hover-class="menu-item-hover">
      <view class="menu-left">
        <view class="menu-icon wishlist-icon">
          <text>♡</text>
        </view>
        <text class="menu-label">心愿单</text>
      </view>
      <view class="menu-right">
        <text class="menu-count">{{wishlistCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-item" bind:tap="handlePurchased" hover-class="menu-item-hover">
      <view class="menu-left">
        <view class="menu-icon purchased-icon">
          <text>✓</text>
        </view>
        <text class="menu-label">已购买</text>
      </view>
      <view class="menu-right">
        <text class="menu-count">{{purchasedCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" data-page="squad" bind:tap="handleHangar"><view class="menu-left"><view class="menu-icon purchased-icon"><text>✦</text></view><text class="menu-label">六机出击 · 本命阵容</text></view><text class="menu-arrow">›</text></view>
    <view class="menu-divider"></view>
    <view class="menu-item" data-page="quiz" bind:tap="handleHangar"><view class="menu-left"><view class="menu-icon wishlist-icon"><text>?</text></view><text class="menu-label">胶佬默契局</text></view><text class="menu-arrow">›</text></view>
    <view class="menu-divider"></view>
    <view class="menu-item" data-page="builds" bind:tap="handleHangar"><view class="menu-left"><view class="menu-icon purchased-icon"><text>⚙</text></view><text class="menu-label">堆积清零 · 机库整备</text></view><text class="menu-arrow">›</text></view>
  </view>
  <view style="height: {{safeAreaBottom}}px;"></view>
</scroll-view>
