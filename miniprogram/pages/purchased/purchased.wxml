<view class="page">
  <header title="已购买" showBack bind:back="handleBack" />

  <collection-share wx:if="{{features.sharing && shareModelIds.length > 0 && !loadError && !loading}}" kind="purchased" modelIds="{{shareModelIds}}" bind:prepared="handleSharePrepared" />

  <view class="content">
    <view class="status-state" wx:if="{{loading && totalCount === 0}}">
      <view class="status-art loading-art">
        <view class="loading-scan"></view>
        <image class="loading-image" src="/assets/gundam-loading.png" mode="aspectFit" />
      </view>
      <text class="status-title">正在加载已购买</text>
      <text class="status-subtitle">正在同步你的入手记录</text>
      <view class="status-action">
        <view class="loading-dots"><view></view><view></view><view></view></view>
      </view>
    </view>

    <view class="status-state" wx:elif="{{loadError && totalCount === 0}}">
      <image class="status-art" src="/assets/gundam-loading.png" mode="aspectFit" />
      <text class="status-title">已购买加载失败</text>
      <text class="status-subtitle">请检查网络后重试</text>
      <view class="status-action">
        <button class="retry-button" bind:tap="handleRetry" hover-class="explore-hover">点击重试</button>
      </view>
    </view>

    <!-- Empty state -->
    <view class="status-state" wx:elif="{{totalCount === 0}}">
      <view class="status-art"><text class="empty-icon">✓</text></view>
      <text class="status-title empty-title">还没有已购买的模型</text>
      <text class="status-subtitle empty-subtitle">记录你入手的每一台高达</text>
      <view class="status-action">
        <view class="explore-button" bind:tap="handleExplore" hover-class="explore-hover">
          <text>去探索</text>
        </view>
      </view>
    </view>

    <!-- Main content -->
    <view class="list-state" wx:else>
      <view class="refresh-banner" wx:if="{{loading || loadError}}">
        <view class="inline-spinner" wx:if="{{loading}}"></view>
        <text class="refresh-message">{{loading ? '正在更新已购买…' : '加载失败，已保留上次的入手记录'}}</text>
        <button class="inline-retry" size="mini" wx:if="{{loadError && !loading}}" bind:tap="handleRetry" hover-class="explore-hover">重试</button>
      </view>
      <scroll-view class="scroll-area" scroll-y="{{canScrollY}}" style="padding-bottom: calc(64rpx + {{safeAreaBottom}}px);">

      <!-- Stats section -->
      <view class="stats-section" wx:if="{{hasStats}}">

        <!-- Stats header -->
        <view class="stats-header">
          <view class="stats-count">
            <text class="stats-count-label">已入手</text>
            <text class="stats-count-value">{{totalCount}}</text>
            <text class="stats-count-label">台</text>
          </view>
          <view class="stats-spent">
            <text class="stats-spent-label">总花费</text>
            <text class="stats-spent-currency">¥</text>
            <text class="stats-spent-value">{{totalSpentText}}</text>
          </view>
        </view>

        <view wx:if="{{features.builds}}" class="build-entry" bind:tap="handleBuilds"><text>机库整备 · 记录拼装成果</text><text>›</text></view>
        <text wx:if="{{features.pilotRating && features.builds && buildProgressKnown}}" class="rating-note">趣味评级按完工、整备、档案、等级探索和目标记录计算，与花费无关。</text>
        <text class="rating-note" wx:if="{{features.pilotRating && features.builds && buildSyncError}}" bind:tap="handleRetry">{{buildProgressKnown ? '拼装进度同步失败，评级暂用上次记录。点击此处重新同步。' : '拼装进度同步失败，暂无法计算评级。点击此处重新同步。'}}</text>
        <!-- Radar chart section -->
        <view class="radar-section" wx:if="{{features.pilotRating && features.builds && buildProgressKnown}}">
          <view class="radar-canvas-wrapper">
            <canvas id="radarCanvas" type="2d" class="radar-canvas"></canvas>
          </view>
          <view class="pilot-info">
            <text class="pilot-rank">{{pilotRank}}</text>
            <text class="pilot-title">{{pilotTitle}}</text>
          </view>
          <view class="score-toggle" bind:tap="handleToggleScoreDetail">
            <text>{{scoreDetailOpen ? '收起 ▲' : '展开 ▼'}}</text>
          </view>
        </view>

        <!-- Score detail panel -->
        <view class="score-detail" wx:if="{{features.pilotRating && features.builds && buildProgressKnown && scoreDetailOpen}}">
          <view class="score-detail-header">
            <text class="score-detail-rank">{{pilotRank}} · {{pilotScore}}分</text>
            <text class="score-detail-next" wx:if="{{nextRank}}">→ {{nextRank}}（{{nextRankScore}}分）</text>
          </view>
          <view class="score-progress-track">
            <view class="score-progress-fill" style="width: {{pilotScore}}%;"></view>
          </view>
          <text class="score-gap-text" wx:if="{{nextRank}}">还需 {{scoreGap}} 分升级</text>
          <text class="score-gap-text" wx:else>已达最高等级</text>

          <view class="dim-list">
            <view class="dim-item" wx:for="{{dimDetails}}" wx:key="label">
              <view class="dim-item-header">
                <text class="dim-item-label">{{item.label}}</text>
                <text class="dim-item-value">{{item.valueText}}</text>
              </view>
              <view class="dim-bar-track">
                <view class="dim-bar-fill" style="width: {{item.percent}}%;"></view>
              </view>
            </view>
          </view>

          <view class="upgrade-tip">
            <text class="upgrade-tip-tag">升级建议</text>
            <text class="upgrade-tip-text">{{upgradeTip}}</text>
          </view>
        </view>

        <!-- Power gauge (price comparison) -->
        <view class="power-gauge" wx:if="{{hasCompare}}">
          <view class="gauge-row">
            <text class="gauge-label">官方定价参考</text>
            <view class="gauge-track">
              <view class="gauge-fill original" style="width: 100%;"></view>
            </view>
            <text class="gauge-value">¥{{totalOriginalText}}</text>
          </view>
          <view class="gauge-row">
            <text class="gauge-label">实付总额</text>
            <view class="gauge-track">
              <view class="gauge-fill actual" style="width: {{spentPercent}}%;"></view>
            </view>
            <text class="gauge-value">¥{{totalSpentText}}</text>
          </view>
          <view class="saved-row">
            <text class="{{savedIsNegative ? 'saved-amount-negative' : 'saved-amount'}}">{{savedIsNegative ? '高于参考' : '低于参考'}} ¥{{savedAmountText}}</text>
            <text class="saved-label">{{savedFunText}}</text>
          </view>
        </view>

        <!-- Series breakdown bar -->
        <view class="series-bar-section" wx:if="{{seriesBreakdown.length > 1}}">
          <view class="series-bar">
            <view
              wx:for="{{seriesBreakdown}}"
              wx:key="code"
              class="series-segment {{item.code}}"
              style="width: {{item.percent}}%;"
            ></view>
          </view>
          <view class="series-legend">
            <view class="legend-item" wx:for="{{seriesBreakdown}}" wx:key="code">
              <view class="legend-dot {{item.code}}"></view>
              <text class="legend-text">{{item.label}} {{item.count}}台</text>
            </view>
          </view>
        </view>

      </view>

      <!-- Purchase list -->
      <view class="purchase-list">
        <view class="purchase-card-wrapper" wx:for="{{purchaseItems}}" wx:key="modelId">
          <view
            class="swipe-container"
            bind:touchstart="handleTouchStart"
            bind:touchmove="handleTouchMove"
            bind:touchend="handleTouchEnd"
            bind:touchcancel="handleTouchEnd"
            data-index="{{index}}"
          >
            <view class="purchase-card {{swipeOpenIndex === index ? 'swipe-open' : ''}}"
              style="{{activeSwipeIndex === index ? activeSwipeStyle : ''}}">
              <view class="card-thumb" catch:tap="handleThumbTap" data-index="{{index}}">
                <image
                  wx:if="{{item.model}}"
                  src="{{item.model.imageUrl}}"
                  mode="aspectFill"
                  lazy-load
                ></image>
                <view class="missing-thumb" wx:else>待同步</view>
              </view>
              <view class="card-info" catch:tap="handleInfoTap" data-index="{{index}}">
                <view class="card-top-row">
                  <text class="card-series">{{item.seriesLabel}}{{item.numberText ? ' #' + item.numberText : ''}}</text>
                  <text class="card-date">{{item.displayDate}}</text>
                </view>
                <text class="card-name">{{item.model ? item.model.name : '模型信息暂未同步'}}</text>
                <text class="card-note" wx:if="{{!item.model}}">{{item.modelId}}</text>
                <view class="card-bottom-row">
                  <text class="card-price" wx:if="{{item.priceText}}">¥{{item.priceText}}</text>
                  <text class="card-no-price" wx:else>未填写价格</text>
                  <view class="card-channel" wx:if="{{item.record.channel}}">
                    <badge variant="default"><text class="card-channel-text">{{item.record.channel}}</text></badge>
                  </view>
                </view>
                <view class="card-footer">
                  <text class="card-note" wx:if="{{item.record.note}}">{{item.record.note}}</text>
                  <text class="card-edit-hint">编辑</text>
                </view>
              </view>
            </view>
            <view class="delete-action" catch:tap="handleDelete" data-model-id="{{item.record.modelId}}">
              <text>删除</text>
            </view>
          </view>
        </view>
      </view>

    </scroll-view>
    </view>
  </view>

  <!-- Model detail bottom sheet -->
  <model-detail
    model="{{selectedModel}}"
    open="{{detailOpen}}"
    isFavorite="{{selectedIsWishlist}}"
    isPurchased="{{true}}"
    exchangeRate="{{exchangeRate}}"
    bind:close="handleDetailClose"
    bind:togglefavorite="handleToggleWishlist"
    bind:purchase="handlePurchaseAction"
  />

  <!-- Purchase form -->
  <purchase-form
    open="{{formOpen}}"
    modelId="{{formModelId}}"
    modelName="{{formModelName}}"
    priceCny="{{formPriceCny}}"
    purchaseDate="{{formPurchaseDate}}"
    channel="{{formChannel}}"
    note="{{formNote}}"
    bind:close="handleFormClose"
    bind:submit="handleFormSubmit"
  />
</view>
