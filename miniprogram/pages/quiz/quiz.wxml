<view class="page">
  <header title="机库默契测试" showBack bind:back="handleBack" />
  <feature-unavailable wx:if="{{!featureEnabled}}" />
  <block wx:else>
  <scroll-view class="scroll-area" scroll-y wx:if="{{!pickerOpen}}">
    <view class="body" style="padding-bottom: calc(60rpx + {{safeAreaBottom}}px)">
      <view class="hero"><text class="eyebrow">HANGAR / CHEMISTRY TEST</text><text class="hero-title">谁更懂你的机库？</text><text class="subtitle">你来选题、配置 3 个选项，并亲自指定答案。好友作答后由服务端判分。</text></view>
      <input class="title-input" value="{{title}}" maxlength="30" placeholder="测试标题，最多30字" bind:input="handleTitle" />
      <view class="question-card" wx:for="{{questions}}" wx:key="id" wx:for-item="question" wx:for-index="questionIndex">
        <view class="question-heading"><text class="question-number">0{{questionIndex + 1}} / 03</text><text class="answer-status {{question.answerId ? 'ready' : ''}}">{{question.answerId ? '答案已指定' : '待指定答案'}}</text></view>
        <picker range="{{templates}}" value="{{question.templateIndex}}" data-index="{{questionIndex}}" bind:change="handleTemplate"><view class="prompt-selector"><text>{{question.prompt}}</text><text class="picker-chevron">⌄</text></view></picker>
        <view class="question-empty" wx:if="{{!question.models.length}}">为这道题挑选 3 台候选机体</view>
        <view class="option-list">
          <view wx:for="{{question.models}}" wx:key="id" class="option {{question.answerId === item.id ? 'chosen' : ''}}" data-index="{{questionIndex}}" data-id="{{item.id}}" bind:tap="handleAnswer">
            <image class="option-image" src="{{item.imageUrl}}" mode="aspectFit" /><view class="option-copy"><text class="model-code">{{item.series}} / {{item.number}}</text><text class="option-name">{{item.name}}</text></view><text class="answer-radio">{{question.answerId === item.id ? '✓' : ''}}</text>
          </view>
        </view>
        <button class="secondary-button" data-index="{{questionIndex}}" bind:tap="handleOpenPicker">{{question.models.length ? '编辑 3 个选项' : '选择 3 个选项'}}</button>
        <text class="helper" wx:if="{{question.models.length}}">点击一个选项，设为你心中的正确答案。</text>
      </view>
      <button wx:if="{{features.sharing && preparedId}}" class="primary-button" open-type="share">邀请好友来答题</button>
      <button wx:elif="{{features.sharing}}" class="primary-button" loading="{{preparing}}" disabled="{{preparing}}" bind:tap="handlePrepareShare">{{shareError ? '重试生成测试' : '生成默契测试'}}</button>
      <text class="error-text" wx:if="{{shareError}}">{{shareError}}</text>
      <text class="helper">{{preparedId ? '测试已就绪；修改任何题目后需要重新生成。' : '答案由你选择，不会根据收藏记录自动猜测。'}}</text>
    </view>
  </scroll-view>
  <view class="picker-page" wx:else>
    <view class="picker-toolbar"><button bind:tap="handleCancelPicker">返回</button><text>第 {{activeQuestion + 1}} 题 · 选择 3 台</text><button bind:tap="handleClosePicker">完成</button></view>
    <scroll-view class="scroll-area" scroll-y><view class="body" style="padding-bottom: calc(60rpx + {{safeAreaBottom}}px)"><button wx:if="{{features.squad && squadModels.length >= 3}}" class="secondary-button use-squad" bind:tap="handleUseSquad">复用六机编队前 3 台</button><model-picker selectedIds="{{activeOptionIds}}" limit="{{3}}" bind:change="handleSelection" /></view></scroll-view>
  </view>
  </block>
</view>
