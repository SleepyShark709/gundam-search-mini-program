## 本地开发：从此模板复制为 .env，填入真实数据库凭据
## 在云托管运行时这些变量由控制台环境变量提供，无需 .env 文件
##
## 用法：cp .env.example .env  然后编辑

# CynosDB 外网地址（从腾讯云控制台拿）
MYSQL_ADDRESS=sh-cynosdbmysql-grp-xxxxxx.sql.tencentcdb.com:22899
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# 正常认证要求云托管注入 X-WX-SOURCE / X-WX-APPID / X-WX-OPENID
WX_APPID=wx422623fec834054c
# 仅本机模拟器联调：显式 development + mock 开关，且实际连接地址必须为 loopback
# 生产禁止启用 ALLOW_LOCAL_MOCK_AUTH；误开会使服务启动失败
NODE_ENV=development
ALLOW_LOCAL_MOCK_AUTH=true

# 论坛管理员 openid 白名单（逗号分隔），本地默认填 local-dev-user 方便测试管理员功能
ADMIN_OPENIDS=local-dev-user

# 内容安全审核：本地默认跳过（也可不写，没有 token 文件时自动跳过）
SKIP_MSG_SEC_CHECK=true

# 新功能默认关闭；部署后将需要的功能显式设为 true（仅精确 true 生效）
# 分享还要求对应玩法开启：squad / quiz / compare / report（依赖 builds）
FEATURE_DISCOVERY=false
FEATURE_SHARING=false
FEATURE_SQUAD=false
FEATURE_QUIZ=false
FEATURE_BUILDS=false
FEATURE_LINEAGE=false
FEATURE_COMPARE=false
FEATURE_PILOT_RATING=false
